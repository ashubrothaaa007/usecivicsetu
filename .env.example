# CivicSetu Environment Variables Template
# Copy this file to .env or .env.local and fill in your actual credentials.
# NEVER commit .env or .env.local to GitHub or public repositories.

# Google Gemini API Key (Required for AI image analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Configuration (Required for complaints storage & Realtime)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
